# ---- LLM (any OpenAI-compatible endpoint: OpenAI, vLLM, LM Studio, Ollama...) ----
AI_MODEL_PATH="gpt-4o-mini"
AI_MODEL_API=""                 # e.g. http://localhost:1234/v1 ; empty = api.openai.com
API_KEY=""                      # your OpenAI key
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024

# ---- Knowledge base ----
# Empty = embed vectordb/data/LearningPath.xlsx into an in-memory store (no database needed).
# Set it to use PGVector instead (see vectordb/docker-compose.yml), e.g.
# PGVECTOR_CONN="postgresql+psycopg2://postgres:postgres@localhost:5433/vectordb"
PGVECTOR_CONN=""
PGVECTOR_COLLECTION="langchain_pg_embedding"
HUGGINGFACE_HUB_TOKEN=""

# ---- Tools ----
TAVILY_API_KEY=""               # web search agent
VIRUSTOTAL_API_KEY=""           # URL safety scan before crawling
REQUIRE_URL_SCAN=false          # true = refuse to crawl when no VirusTotal key is set

# ---- Web server / access control ----
HOST="127.0.0.1"
PORT=8000
APP_PASSWORD=""                 # set on any public deployment
APP_SECRET=""                   # token signing key; random per start if empty
RATE_LIMIT_PER_MINUTE=20        # chat requests per client, 0 = off

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="AI-Learning-Assistant"
